<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Vista.DetalleMateriaActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpGaleria"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnRegresar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:backgroundTint="#1E88E5"
            android:text="@string/btnRegresar"
            android:textColor="#FFFFFF" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtdetalleMateria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="PROGRAMACIÓN AVANZADA" />

            <TextView
                android:id="@+id/txtdetalleCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                tools:text="Código: IS102" />

            <TextView
                android:id="@+id/lblDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/lblDescripcion"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtdetalleDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Curso de programación avanzada con patrones de diseño y arquitectura MVP." />

            <TextView
                android:id="@+id/lblEspacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/lblEspacio"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtdetalleEspacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Edificio K, Salón A-102" />

            <TextView
                android:id="@+id/lblTotalHoras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/lblTotalHoras"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtdetalleTotalHoras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="80 Horas" />

            <TextView
                android:id="@+id/lblDiasAtencion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/lblDiasAtencion"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtdetalleDiasAtencion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Lunes, Miércoles, Viernes (10:00 - 12:00 hrs)" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>