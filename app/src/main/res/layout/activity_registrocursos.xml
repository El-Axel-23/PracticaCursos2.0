<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    tools:context=".Vista.registrocursos">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1565B8"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Regresar"
            android:padding="16dp"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="REGISTRO AL CURSO"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/svRegistro"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/txtSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Completa los datos para inscribirte"
                android:textColor="#687385"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNombreCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#E5EDF8"
                android:gravity="center"
                android:minHeight="76dp"
                android:padding="16dp"
                android:text="INSCRIPCIÓN AL CURSO"
                android:textColor="#172B4D"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTmatricula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="MATRÍCULA DEL ALUMNO:"
                android:textColor="#26364A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtMatriculaAlumno"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:textColor="#26364A"
                android:hint="202113046"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="15"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtTfecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="FECHA DE REGISTRO:"
                android:textColor="#26364A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtFechaRegistro"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:cursorVisible="false"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:focusable="false"
                android:textColor="#26364A"
                android:hint="AAAA-MM-DD"
                android:inputType="none"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtTcorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CORREO INSTITUCIONAL:"
                android:textColor="#26364A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtCorreoInstitucional"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:clickable="false"
                android:focusable="false"
                android:hint="Correo institucional"
                android:textColor="#26364A"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnConfirmarInscripcion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#168747"
                android:text="CONFIRMAR INSCRIPCIÓN"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E1E6ED"
                android:text="CANCELAR"
                android:textColor="#26364A"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>

